{
  "baseURL": "https://tsvsheet.github.io/docs.tsvsheet.goldmark/",
  "title": "tsvsheet.goldmark",
  "publishDir": "_site",
  "enableRobotsTXT": true,
  "markup": {
    "goldmark": {
      "renderHooks": {
        "link": { "useEmbedded": "fallback" },
        "image": { "useEmbedded": "fallback" }
      }
    }
  },
  "params": {
    "description": "Renders tsvsheet code blocks as computed tables in goldmark markdown."
  }
}
